# Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/unimart

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_unimart_local_development_replace_in_prod
JWT_EXPIRES_IN=7d

# Email / SMTP
# Leave blank in development — Ethereal test accounts are provisioned automatically
# In production, provide real SMTP credentials
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=UniMart <noreply@unimart.lk>
VERIFICATION_CODE_EXPIRY_MINUTES=15

# Rate Limiting
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10

# Admin Seed User (used by `npm run seed`)
ADMIN_EMAIL=admin@cmb.ac.lk
ADMIN_PASSWORD=Admin@UniMart2024!
ADMIN_FULL_NAME=UniMart Admin

# Cloudinary Image Storage (required for image uploads in production)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Listing Moderation
# Set ADMIN_SETTING_DEFAULT_STATUS=pending to require admin approval before listings go live
# Set to 'active' (default) for immediate publication
ADMIN_SETTING_DEFAULT_STATUS=active
