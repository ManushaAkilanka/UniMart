{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "description": "UniMart Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/scripts/seed.js",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^6.10.1",
    "socket.io": "^4.8.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.9",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "vitest": "^4.1.11"
  },
  "vitest": {
    "environment": "node",
    "testTimeout": 30000,
    "hookTimeout": 360000,
    "fileParallelism": false,
    "poolOptions": {
      "forks": {
        "singleFork": true
      }
    }
  }
}
